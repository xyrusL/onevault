# OneVault Environment Configuration Template
# Duplicate this file to .env for local development, or add these variables to Vercel and Cloudflare.

# --- Vercel Frontend Environment Variables ---
# The public URL of your deployed Cloudflare Worker (e.g. https://onevault-worker.<subdomain>.workers.dev)
VITE_WORKER_URL=

# --- Cloudflare Worker Environment Variables & Secrets ---
# Sign-in Credentials for Admin Portal
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_password_here
SESSION_SECRET=your_random_32_character_session_signing_secret

# Cloudflare Account & Worker Settings
CF_ACCOUNT_ID=your_cloudflare_account_id
WORKER_NAME=onevault-worker

# Cloudflare API Token (with Email Routing & Zone permissions)
CF_API_TOKEN=your_cloudflare_api_token
