{
  "name": "onevault",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:types": "wrangler types",
