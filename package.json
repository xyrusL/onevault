    "@tiptap/starter-kit": "^3.31.4",
    "@types/d3-geo": "^3.1.1",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "d3-geo": "^3.1.1",
    "hono": "^4.0.0",
